# Environment Configuration for Klaro Backend

# Database Configuration
# For PostgreSQL (production)
DATABASE_URL=postgresql://klaro_user:your_secure_password@localhost:5432/klaro

# For SQLite (development fallback)
# DATABASE_URL=sqlite:///./data/klaro.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001
DEBUG=True

# File Upload Configuration
MAX_FILE_SIZE=52428800  # 50MB
SESSION_TIMEOUT=86400   # 24 hours

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat

# Supabase Storage (production persistence for uploads + trained models)
# Leave blank for local development — the app falls back to pure local disk.
# SUPABASE_URL:         https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY: the service_role key (server-side only; bypasses RLS)
# SUPABASE_BUCKET:      storage bucket name (default: klaro)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=klaro

# Application Configuration
APP_NAME=Klaro - Mini AI Analyst
APP_VERSION=1.0.0

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
